# ---------- Для сайта: попадают в браузер. Это нормально: доступ ограничен RLS, GRANT и функциями ----------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- Только для команд tenant:* на вашем компьютере. НЕ добавляйте в Cloudflare и не коммитьте ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# адрес сайта в Vercel (запасной в Cloudflare: https://sgx-booking.pages.dev)
PUBLIC_SITE_URL=https://sgx-booking-alpha.vercel.app
DEFAULT_TENANT=graphite
CF_PAGES_PROJECT=sgx-booking

# ---------- Для тестов ----------
# SQL-тесты: локальный Supabase после `supabase db reset` (SKIP_SETUP=1) или пустой PostgreSQL 15+
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Playwright: демо-владелец из seed (только локально)
OWNER_EMAIL=owner@graphite.local
OWNER_PASSWORD=demo-owner-pass

# ---------- Секреты Edge Function (задаются командой supabase secrets set, не здесь) ----------
